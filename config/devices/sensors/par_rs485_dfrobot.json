{
    "category": "SENSOR",
    "commands": {
        "READ": {
            "argMapping": {
                "rx": "$PIN",
                "tx": "$PIN2"
            },
            "hwCmd": "UART_TRANSFER",
            "params": {
                "baud": 4800,
                "preDelay": 100,
                "readLen": 7,
                "timeout": 500,
                "wait": 100,
                "write": [
                    1,
                    3,
                    0,
                    0,
                    0,
                    1,
                    132,
                    10
                ]
            },
            "responseProcessing": {
                "endian": "big",
                "length": 2,
                "offset": 3,
                "type": "bytes"
            },
            "valuePath": "data[3]"
        }
    },
    "defaultRole": "par",
    "defaults": {
        "sampling": {
            "count": 1,
            "delayMs": 200
        },
        "validation": {
            "fallbackAction": "error",
            "retryCount": 3
        }
    },
    "description": "The photosynthetically active radiation sensor uses the principle of photoelectric sensing and can measure the photosynthetically active radiation value in the spectral range of 400-700nm. ",
    "driverId": "UNIVERSAL_DRIVER",
    "hardware": {
        "capabilities": [
            "UART_TRANSFER"
        ],
        "interface": "uart",
        "pins": [
            {
                "name": "RX",
                "type": "DIGITAL_IN"
            },
            {
                "name": "TX",
                "type": "DIGITAL_OUT"
            }
        ],
        "supportsTemperatureCompensation": false,
        "voltage": [
            5,
            9,
            12,
            24
        ]
    },
    "id": "par_rs485_dfrobot",
    "isParentTemplate": false,
    "measurements": {
        "raw_value": {
            "limits": {
                "max": 4000,
                "min": 0
            },
            "type": "float",
            "unit": "umol/m2/s"
        }
    },
    "name": "PAR RS485 DFRobot",
    "resourceRoles": [
        "par"
    ],
    "roles": {
        "par": {
            "allowedStrategies": [
                "none",
                "linear"
            ],
            "defaultStrategy": "none",
            "description": "Measure Photosynthetically Active Radiation for grow lights.",
            "displayUnits": [
                "umol/m2/s"
            ],
            "label": "PAR Meter",
            "source": "raw_value",
            "standardUnit": "umol/m2/s"
        }
    },
