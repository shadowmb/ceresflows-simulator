{
  "name": "client",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "bin": "dist-pkg/server.cjs",
  "pkg": {
    "scripts": [
      "dist-pkg/server.cjs"
    ],
    "assets": [
      "dist/**/*",
      "config/**/*"
    ],
    "targets": [
      "node18-win-x64",
      "node18-linux-arm64"
    ]
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:backend": "esbuild server/server.ts --bundle --platform=node --format=cjs --outfile=dist-pkg/server.cjs",
    "build:release": "npm run build && npm run build:backend && node scripts/finalize_release.cjs",
    "build:exe": "npm run build && npm run build:backend && pkg . --out-path release/bin",
    "server": "tsx server/server.ts",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-slot": "^1.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "express": "^5.2.1",
    "lucide-react": "^0.564.0",
    "mqtt": "^5.15.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.4.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/express": "^5.0.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.24",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "pkg": "^5.8.1",
    "postcss": "^8.5.6",
    "tailwindcss": "3.4",
    "tsx": "^4.19.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1"
  }
}